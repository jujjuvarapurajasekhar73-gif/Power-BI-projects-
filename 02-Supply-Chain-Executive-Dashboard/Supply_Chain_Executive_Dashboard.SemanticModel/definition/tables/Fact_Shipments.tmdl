	partition Fact_Shipments = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\Raja shekar\Downloads\power bi practice\Supply Chain & Inventory Optimization\Fact_Shipments.csv"),[Delimiter=",", Columns=11, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				
				    ParseMixedDate = (val as any) as nullable date =>
				        let
				            txt = Text.Trim(Text.From(val)),
				            cleanTxt = Text.Replace(txt, "-", "/"),
				            parts = Text.Split(cleanTxt, "/"),
				            parsed = if List.Count(parts) = 3 then
				                if Text.Length(parts{0}) = 4 then
				                    #date(Number.From(parts{0}), Number.From(parts{1}), Number.From(parts{2}))
				                else if Number.From(parts{0}) > 12 then
				                    #date(Number.From(parts{2}), Number.From(parts{1}), Number.From(parts{0}))
				                else
				                    #date(Number.From(parts{2}), Number.From(parts{0}), Number.From(parts{1}))
				            else null
				        in
				            try parsed otherwise null,
				
				    CleanDates = Table.TransformColumns(#"Promoted Headers", {
				        {"Order_Date", ParseMixedDate, type date},
				        {"Ship_Date", ParseMixedDate, type date},
				        {"Delivery_Date", ParseMixedDate, type date}
				    }),
				    #"Changed Type" = Table.TransformColumnTypes(CleanDates,{{"Order_Qty", Int64.Type}, {"Unit_Cost", type number}, {"Shipping_Cost", type number}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each [Order_Qty] > 0),
				    #"Replaced Value" = Table.ReplaceValue(#"Filtered Rows","","WH-Unknown",Replacer.ReplaceValue,{"Warehouse_ID"})
				in
				    #"Replaced Value"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

