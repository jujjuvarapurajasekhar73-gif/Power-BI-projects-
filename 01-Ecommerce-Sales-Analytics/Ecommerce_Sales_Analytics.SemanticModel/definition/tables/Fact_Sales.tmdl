	partition Fact_Sales = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(File.Contents("C:\Users\Raja shekar\Downloads\power bi practice\Fact_Sales.csv"),[Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Order_ID", type text}, {"Order_Date", type text}, {"Customer_ID", type text}, {"Product_ID", type text}, {"Quantity", Int64.Type}, {"Discount", type number}, {"Revenue", type text}, {"Sales_Channel", type text}, {"Payment_Mode", type text}}),
				    #"Merged Queries" = Table.FuzzyNestedJoin(#"Changed Type", {"Customer_ID"}, Dim_Customers, {"Customer_ID"}, "Dim_Customers", JoinKind.LeftOuter, [IgnoreCase=true, IgnoreSpace=true]),
				    #"Expanded Dim_Customers" = Table.ExpandTableColumn(#"Merged Queries", "Dim_Customers", {"City", "State", "Segment"}, {"Dim_Customers.City", "Dim_Customers.State", "Dim_Customers.Segment"}),
				    #"Added Index" = Table.AddIndexColumn(#"Expanded Dim_Customers", "Index", 1, 1, Int64.Type),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Index",{{"Index", "Region_ID"}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns","-","/",Replacer.ReplaceText,{"Order_Date"}),
				    #"Added Custom" = Table.AddColumn(#"Replaced Value", "Clean_Order_Date", each let
				    rawText = Text.Trim(Text.From([Order_Date])),
				    cleanText = Text.Replace(Text.Replace(rawText, "-", "/"), ".", "/"),
				    parts = Text.Split(cleanText, "/"),
				    resultDate = 
				        if List.Count(parts) = 3 then
				            let
				                p0 = try Number.FromText(parts{0}) otherwise null,
				                p1 = try Number.FromText(parts{1}) otherwise null,
				                p2 = try Number.FromText(parts{2}) otherwise null
				            in
				                if p0 <> null and p1 <> null and p2 <> null then
				                    // Case 1: Year comes first (yyyy/mm/dd or yyyy/dd/mm)
				                    if p0 > 1000 then
				                        if p1 <= 12 and p2 <= 31 then try #date(p0, p1, p2) otherwise null
				                        else if p2 <= 12 and p1 <= 31 then try #date(p0, p2, p1) otherwise null
				                        else null
				                    // Case 2: Year comes last (dd/mm/yyyy or mm/dd/yyyy)
				                    else if p2 > 1000 then
				                        if p1 <= 12 and p0 <= 31 then try #date(p2, p1, p0) otherwise null
				                        else if p0 <= 12 and p1 <= 31 then try #date(p2, p0, p1) otherwise null
				                        else null
				                    else null
				                else
				                    // Fallback for text-based month names (e.g., 15-Aug-2025)
				                    try Date.FromText(cleanText, "en-IN") otherwise try Date.FromText(cleanText, "en-US") otherwise null
				        else
				            // Fallback for standard date strings
				            try Date.FromText(cleanText, "en-IN") otherwise try Date.FromText(cleanText, "en-US") otherwise null
				in
				    resultDate),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"Order_Date"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Columns", {"Order_ID"}),
				    #"Filtered Rows" = Table.SelectRows(#"Removed Duplicates", each ([Order_ID] <> "")),
				    #"Trimmed Text" = Table.TransformColumns(#"Filtered Rows",{{"Customer_ID", Text.Trim, type text}}),
				    #"Filtered Rows1" = Table.SelectRows(#"Trimmed Text", each [Quantity] > 0),
				    #"Filtered Rows2" = Table.SelectRows(#"Filtered Rows1", each true)
				in
				    #"Filtered Rows2"
				```

	annotation PBI_ResultType = Table

